# Configuración de Supabase
# Obtén estos valores en el panel de tu proyecto: https://app.supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Número de WhatsApp por defecto (formato internacional sin +, ej: 51942990279)
VITE_DEFAULT_WHATSAPP=51942990279
